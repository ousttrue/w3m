#
# w3mimg/x11/Makefile
#
#
@SET_MAKE@
SHELL=@SHELL@
WARNINGS  = -Wall
WARNINGS += -Werror=vla
CFLAGS=$(WARNINGS) $(OPTS) -I../.. @CFLAGS@ @CPPFLAGS@ @DEFS@ $(IMGCFLAGS)
RM=rm

IMGCFLAGS=@IMGX11CFLAGS@
OBJS=x11_w3mimg.o

all: x11_w3mimg.o

x11_w3mimg.o: x11_w3mimg.c
	$(CC) $(CFLAGS) -c $<

clean:
	@-$(RM) -f *.o

distclean: clean
	-$(RM) -f Makefile

#


