#
# w3mimg/fb/Makefile
#
#
@SET_MAKE@
SHELL=@SHELL@
WARNINGS  = -Wall
WARNINGS += -Werror=vla
CFLAGS=$(WARNINGS) $(OPTS) -I../.. @CFLAGS@ @CPPFLAGS@ @DEFS@ $(IMGCFLAGS)
RM=rm

IMGCFLAGS=@IMGFBCFLAGS@
OBJS=fb.o fb_img.o 

all: fb_w3mimg.o fb.o fb_img.o

fb_w3mimg.o: fb_w3mimg.c
	$(CC) $(CFLAGS) -c $<

fb.o: fb.c
	$(CC) $(CFLAGS) -c $<

fb_img.o: fb_img.c fb_gdkpixbuf.c fb_imlib2.c
	$(CC) $(CFLAGS) -c $<

clean:
	@-$(RM) -f *.o

distclean: clean
	-$(RM) -f Makefile

#


