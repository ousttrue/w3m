#
# w3mimg/win/Makefile
#
#
@SET_MAKE@
SHELL=@SHELL@
WARNINGS  = -Wall
WARNINGS += -Werror=vla
CFLAGS=$(WARNINGS) $(OPTS) -I../.. @CFLAGS@ @CPPFLAGS@ @DEFS@ $(IMGCFLAGS)
RM=rm
CC=@CC@
CXX=@CXX@

IMGCFLAGS=@IMGWINCFLAGS@
OBJS=win_w3mimg.o

all: win_w3mimg.o

win_w3mimg.o: win_w3mimg.cpp
	$(CXX) $(CFLAGS) -c $<

clean:
	@-$(RM) -f *.o

distclean: clean
	-$(RM) -f Makefile

#


